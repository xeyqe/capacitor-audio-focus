{
  "name": "capacitor-audio-focus",
  "version": "0.0.4",
  "description": "Android capacitor AudioFocus.",
  "main": "dist/plugin.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "dist/"
  ],
  "author": "xeyqe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeyqe/capacitor-audio-focus.git"
  },
  "bugs": {
    "url": "https://github.com/xeyqe/capacitor-audio-focus/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "verify": "npm run verify:android && npm run verify:web",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "eslint src example/vite.config.ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,mjs,java}\" --plugin=prettier-plugin-java",
    "docgen": "docgen --project tsconfig.docgen.json --api AudioFocusPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/docgen": "0.3.1",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.0",
    "typescript": "~6.0.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "capacitor": {
    "android": {
      "src": "android"
    }
  }
}
